<?xml version="1.0"?>

<!DOCTYPE prefwindow [
  <!ENTITY % browserDTD SYSTEM
    "chrome://browser/locale/browser.dtd">
  <!ENTITY % preferencesDTD SYSTEM
    "chrome://browser/locale/preferences/preferences.dtd">
  <!ENTITY % greasemonkeyDTD SYSTEM
    "chrome://greasemonkey/locale/greasemonkey.dtd">
  %browserDTD;
  %preferencesDTD;
  %greasemonkeyDTD;
]>

<?xml-stylesheet href="chrome://global/skin/global.css"
  type="text/css"?>
<?xml-stylesheet href="chrome://greasemonkey/skin/bindings.css"
  type="text/css"?>
<?xml-stylesheet href="chrome://greasemonkey/skin/options.css"
  type="text/css"?>
<dialog xmlns="http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul"
  xmlns:html="http://www.w3.org/1999/xhtml"
  buttons="accept,cancel"
  id="greasemonkey-options-dialog"
  windowtype="greasemonkey:options"
  title="Greasemonkey - &preferencesCmd2.label;"
  onload="GM_loadOptions();"
  ondialogaccept="GM_saveOptions();"
  ondialogcancel="close();"
  persist="screenX screenY"
  flex="1">

<script type="application/x-javascript"
  src="chrome://greasemonkey/content/options.js" />

<dialogheader title="Greasemonkey" description="&preferencesCmd2.label;" />

<vbox flex="1">
  <groupbox>
    <caption label="&preferencesCmd2.label;" />
    <hbox id="interval-update-box" align="center">
      <label value="&intervalUpdates;" />
      <textbox id="interval-update-value" type="number" min="0" max="365"
        increment="1" size="3" />
      <label value="&intervalUpdatesUnits;" />
      <button id="update-check-now" label="&updatesCheckNow;"
        oncommand="GM_checkUpdatesNow();" />
    </hbox>
    <checkbox id="secure-update" label="&requireSecureUpdates;" />
    <checkbox id="disable-update" label="&requireDisabledScriptsUpdates;" />
    <checkbox id="timeout-update" label="&requireTimeoutUpdates;" />
    <hbox id="timeout-update-box" align="center">
      <label id="timeout-update-value-label" value="&timeoutUpdatesUnits;" />
      <textbox id="timeout-update-value" type="number" min="1" max="60"
        increment="1" size="2" />
      </hbox>
    <!-- The "… updated successfully" message; its "Never show again"
         sets the same pref (notification.muted.script.updated). -->
    <checkbox id="notify-updates" label="Notify script updates" />
    <checkbox id="check-sync" label="&enableSync;" />
  </groupbox>
  <!-- New labels here come from greasemonkey.properties (options.js);
       the English is their fallback. -->
  <groupbox>
    <caption id="toolbar-button-caption" label="Toolbar button" />
    <hbox align="center">
      <label id="badge-show-label" value="Badge:" control="badge-show" />
      <menulist id="badge-show" oncommand="GM_syncBadgeControls();">
        <menupopup>
          <menuitem id="badge-show-none" value="none" label="none" />
          <menuitem id="badge-show-total" value="total"
            label="number of running scripts" />
          <menuitem id="badge-show-unique" value="unique"
            label="number of unique running scripts" />
        </menupopup>
      </menulist>
      <label id="badge-color-label" value="Color:" />
      <html:input id="badge-color" type="color" />
    </hbox>
  </groupbox>
  <groupbox>
    <caption id="script-apis-caption" label="Script APIs" />
    <!-- The tooltip on both lines, as in Violentmonkey. -->
    <checkbox id="http-only-cookies"
      label="Allow GM_cookie to access HTTP-only cookies"
      tooltiptext="When enabled, scripts can read and write cookies with the HTTP-only flag. This allows scripts to access cookies that cannot be accessed via JavaScript. Use with caution as it may pose security risks." />
    <description id="http-only-cookies-note"
      style="opacity: 0.6; -moz-margin-start: 24px; margin-inline-start: 24px;"
      tooltiptext="When enabled, scripts can read and write cookies with the HTTP-only flag. This allows scripts to access cookies that cannot be accessed via JavaScript. Use with caution as it may pose security risks."
      >(only for scripts with this option enabled in their settings)</description>
  </groupbox>

  <!-- PARKED for 3.9: scheduled-backup UI needs fine-tuning before release.
       Re-enable this groupbox together with the backup wiring in
       options.js and the scheduler start() in components/greasemonkey.js.
       (Entity refs inside an XML comment are not parsed, so the unused
       &options.backups; etc. entities cause no harm here.)
  <groupbox>
    <caption label="&options.backups;" />
    <hbox id="interval-backup-box" align="center">
      <label value="&intervalBackups;" />
      <textbox id="interval-backup-value" type="number" min="0" max="365"
        increment="1" size="3" />
      <label value="&intervalBackupsUnits;" />
      <button id="backup-now" label="&backupsNow;"
        oncommand="GM_backupNow();" />
    </hbox>
    <hbox id="backup-folder-box" align="center">
      <label value="&backupsFolder;" />
      <textbox id="backup-folder" readonly="true" flex="1" />
      <button id="backup-browse" label="&backupsBrowse;"
        oncommand="GM_backupBrowseFolder();" />
    </hbox>
    <hbox id="backup-keep-box" align="center">
      <label value="&backupsKeep;" />
      <textbox id="backup-keep-value" type="number" min="1" max="50"
        increment="1" size="2" />
      <label value="&backupsKeepUnits;" />
    </hbox>
  </groupbox>
  -->

  <groupbox>
    <caption label="&options.editor;" />
    <hbox flex="1">
      <textbox id="editor-path" value="" tooltiptext="" readonly="true"
        flex="1" />
      <button oncommand="GM_util.setEditor(0); GM_getEditor();"
        label="&options.browseForEditor;" />
      <button oncommand="GM_util.setEditor(1); GM_getEditor();"
        label="&options.defaultEditor;" />
    </hbox>
  </groupbox>

  <groupbox flex="2">
    <caption label="&options.globalExcludes;" />
    <cludes id="global-excludes" flex="1" />
  </groupbox>

  <groupbox flex="1">
    <caption label="&options.newScript.template;" />
    <checkbox id="new-script-remove-unused"
      label="&options.newScript.removeUnused;" />
    <textbox id="new-script-template"
      multiline="true" rows="5" flex="1" wrap="off" />
  </groupbox>
</vbox>

</dialog>
